*.py[cod]
*$py.class
.venv/
venv/
ENV/

# OS specific files
.DS_Store
Thumbs.db
Desktop.ini
node_modules/

# AI Studio internal artifacts & token caches
.aistudio/
data/token_cache.*
data/*.bin
